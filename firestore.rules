rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Settings Collection - DENY ALL client access
    // Only Cloud Functions (Admin SDK) should read/write credentials
    match /settings/{document} {
      allow read, write: if false;
    }

    // FAQ Rules
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if false;
    }

    // Products Collection Rules
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Document Library Rules
    match /document_library/{document} {
      allow read: if true;
      allow write: if false;
    }

    // User Profile Rules
    match /users/{userId} {
      // Allow users to create their profile only during signup
      // Role MUST be 'user' (prevents privilege escalation to 'admin')
      // Status must be 'approved' or 'pending' (no arbitrary values)
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == 'user'
                    && (request.resource.data.status == 'approved'
                        || request.resource.data.status == 'pending');

      // Allow users to read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow a user to update their own profile as long as they do not
      // elevate privileges by changing role/status. Admins can update any user.
      allow update: if request.auth != null && (
                    (
                      request.auth.uid == userId &&
                      request.resource.data.role == resource.data.role &&
                      request.resource.data.status == resource.data.status
                    ) ||
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
                  );
    }

    // Carts Collection Rules
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders Collection Rules
    match /orders/{orderId} {
      // Allow users to read their own orders, admins can read all
      allow read: if request.auth != null && (
                    request.auth.token.email == resource.data.customerEmail ||
                    request.auth.uid == resource.data.userId ||
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
                  );

      // Orders are created by Cloud Functions (Admin SDK) only
      allow create: if false;

      // Allow users to update orders if they own them (matching email)
      allow update: if request.auth != null &&
                    request.auth.token.email == resource.data.customerEmail;
    }

    // Delivery Feedback Collection Rules
    match /delivery_feedback/{feedbackId} {
      // Allow authenticated users to create feedback for their own orders
      allow create: if request.auth != null &&
                    request.auth.token.email == request.resource.data.customerEmail;

      // Allow users to read their own feedback
      allow read: if request.auth != null &&
                  request.auth.token.email == resource.data.customerEmail;

      // Allow admins to read all feedback
      allow read: if request.auth != null &&
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      // Updates are not allowed - feedback is immutable once created
      allow update: if false;

      // Allow deletion only by admins
      allow delete: if request.auth != null &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Notifications Collection Rules
    match /notifications/{notificationId} {
      // Allow authenticated users to read their own notifications
      allow read: if request.auth != null &&
                 resource.data.notifyTo == request.auth.uid;

      // Allow creation of notifications (typically by cloud functions or admins)
      allow create: if request.auth != null &&
                    request.auth.uid == request.resource.data.notifyTo;

      // Updates are not allowed - notifications are immutable
      allow update: if false;

      // Allow deletion only by the recipient or admins
      allow delete: if request.auth != null &&
                     (resource.data.notifyTo == request.auth.uid ||
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
  }
}
